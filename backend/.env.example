# Copy to .env and fill in the values

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hu_chatbot2

# Signs admin session tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Admin panel login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Set to 1 only for local development (never on a shared network)
FLASK_DEBUG=0
